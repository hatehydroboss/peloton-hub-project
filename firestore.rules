rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admins are the accounts listed in the admins collection (added in the Firebase Console)
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ── MEMBERSHIP TIERS ──────────────────────────────────────
    // Spoke (free) < Chain < Peloton. An event's `min_tier` is the lowest
    // tier allowed to join it. Ranking lets us compare two tiers with a
    // single numeric comparison.
    function tierRank(t) {
      return t == 'Peloton' ? 3 : (t == 'Chain' ? 2 : 1);
    }
    // True when the signed-in member's tier is at or above the event's gate.
    // Admins bypass it — an admin account has no customer profile document.
    // NOTE: the rules language has no `if`, only expressions.
    function tierAllowed(eventId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      return isAdmin()
        || (exists(userPath) && exists(eventPath)
            && tierRank(get(userPath).data.get('tier', 'Spoke'))
               >= tierRank(get(eventPath).data.get('min_tier', 'Spoke')));
    }

    // Admin accounts: an admin reads their own record; records are managed in the Firebase Console only
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Customer profiles + carts
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // New accounts start on the free tier; paid tiers are switched on by an admin
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'active'
        && request.resource.data.tier == 'Spoke'
        && request.resource.data.get('points', 0) == 0;
      allow update: if (signedIn() && request.auth.uid == uid
          && onlyChanges(['first_name', 'last_name', 'name', 'mobile', 'address', 'notifications']))
        || isAdmin();
      match /cart/{item} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Catalog: public read, admin write; checkout/cancel may adjust stock only
    match /products/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn() && onlyChanges(['stock_qty', 'in_stock', 'updated_at']));
      match /reviews/{rid} {
        allow read: if true;
        // Customers can't write the shop's reply or hide flag into their own review
        allow create: if isAdmin()
          || (signedIn() && request.resource.data.user_id == request.auth.uid
              && !request.resource.data.keys().hasAny(['reply', 'reply_by', 'reply_at', 'hidden']));
        // Admins reply, hide/unhide (the `hidden` field) or delete reviews
        allow update, delete: if isAdmin();
      }
    }

    // Admin → Reviews lists every product's reviews at once (a collection-group query)
    match /{path=**}/reviews/{rid} {
      allow read: if true;
    }

    // Events: public read, admin write; RSVPs may change the filled count only
    match /events/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn() && onlyChanges(['filled']));
    }

    match /rsvps/{id} {
      allow read: if isAdmin()
        || (signedIn() && (resource == null || resource.data.user_id == request.auth.uid));
      // A member can only RSVP to an event whose tier gate they clear.
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid
        && tierAllowed(request.resource.data.event_id);
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /wishlists/{id} {
      allow read: if signedIn() && (resource == null || resource.data.user_id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    // Orders: customers create and cancel their own; admins manage all
    match /orders/{orderId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'reserved';
      allow update: if isAdmin()
        // A customer may cancel while the order is Reserved or Preparing, giving a reason
        || (signedIn() && resource.data.user_id == request.auth.uid
            && resource.data.status in ['reserved', 'preparing']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.cancelled_by == 'customer'
            && onlyChanges(['status', 'updated_at', 'cancel_reason', 'cancel_note', 'cancelled_at', 'cancelled_by']));
      match /items/{itemId} {
        allow read: if isAdmin() || (signedIn() &&
          get(/databases/$(database)/documents/orders/$(orderId)).data.user_id == request.auth.uid);
        allow create: if signedIn() &&
          getAfter(/databases/$(database)/documents/orders/$(orderId)).data.user_id == request.auth.uid;
      }
    }

    // Public reference data
    match /promo_codes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Return requests: a customer asks to return items of their own completed order,
    // within 7 days of its delivery (pickup) date; admins approve/reject and receive them
    match /returns/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'requested'
        && returnableOrder(request.resource.data.order_id);
      allow update, delete: if isAdmin();
    }
    function returnableOrder(orderId) {
      let order = get(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.user_id == request.auth.uid
        && order.status == 'completed'
        && order.get('delivered_at', null) is timestamp
        && order.delivered_at > request.time - duration.value(7, 'd');
    }

    // Refunds: recorded and updated by admins; a customer can see their own
    match /refunds/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow write: if isAdmin();
    }

    // Support tickets: a signed-in customer opens their own; only admins read, reply and delete
    match /support_tickets/{id} {
      allow create: if signedIn()
        && request.resource.data.status == 'new'
        && request.resource.data.user_id == request.auth.uid;
      allow read, update, delete: if isAdmin();
      match /replies/{rid} {
        allow read, write: if isAdmin();
      }
    }
  }
}
