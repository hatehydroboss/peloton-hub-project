{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PelotonHub (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "PelotonHub: start server"
    },
    {
      "name": "PelotonHub (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://127.0.0.1:5500/index.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "PelotonHub: start server"
    },
    {
      "name": "PelotonHub Admin (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5500/admin/login.html",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "PelotonHub: start server"
    }
  ]
}
