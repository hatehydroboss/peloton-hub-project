{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PelotonHub: start server",
      "type": "shell",
      "command": "python",
      "args": ["-u", "${workspaceFolder}/.vscode/serve.py", "${workspaceFolder}", "5500"],
      "isBackground": true,
      "presentation": { "reveal": "silent", "panel": "dedicated" },
      "problemMatcher": {
        "owner": "pelotonhub-server",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": { "activesBegin": true, "beginsPattern": "Serving HTTP", "endsPattern": "Serving HTTP" }
      }
    }
  ]
}
