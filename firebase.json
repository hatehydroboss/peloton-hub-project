{
  "hosting": {
    "site": "pelotonhub",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      ".gitignore",
      ".firebase/**",
      ".vscode/**",
      "**/.git/**",
      ".git/**",
      "release/**",
      "README.md",
      "js/firebase-seed.js",
      "js/firebase-stock-seed.js",
      "server/**",
      "fix_mem_module.js",
      "replace_mem_modaljs.js",
      "firestore.rules",
      "render.yaml",
      "**/*-firebase-adminsdk-*.json",
      "**/serviceAccount*.json",
      "**/service-account*.json"
    ],
    "headers": [
      {
        "source": "sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|css|webmanifest)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
