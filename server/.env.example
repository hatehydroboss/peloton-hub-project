# ── MongoDB ──────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/pelotonhub_payments
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pelotonhub_payments
MONGO_URI=mongodb://127.0.0.1:27017/pelotonhub_payments

# ── PayMongo (dashboard.paymongo.com → Developers → API keys) ──
# Secret key: sk_test_… for test mode (fake money). Never put it in the website code.
PAYMONGO_SECRET_KEY=
# Webhook secret (whsk_…) from Developers → Webhooks; optional but recommended
PAYMONGO_WEBHOOK_SECRET=

# ── Firebase sign-in check ───────────────────────────────
FIREBASE_PROJECT_ID=peletonhub
# Admin accounts (Firebase UIDs, comma-separated) — same as Firestore → admins
ADMIN_UIDS=

# ── Where PayMongo may send customers back to, and who may call the API ──
APP_URLS=https://peletonhub.web.app,https://localhost,http://localhost:5500,http://127.0.0.1:5500
CORS_ORIGIN=https://peletonhub.web.app,https://peletonhub.firebaseapp.com,https://localhost,http://localhost:5500,http://127.0.0.1:5500

PORT=5000
